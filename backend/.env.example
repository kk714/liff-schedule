# 複製為 .env 後填入；.env 已列入 .gitignore，不可提交。
# docker run --env-file .env -v liff-data:/data -p 8000:8000 liff-schedule

# LINE Messaging API（Channel Secret 用於 webhook 驗簽）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LIFF 網址，出現在確認卡「修改」、處理較久、綁定說明等訊息中；CLI 的邀請連結也用它
LIFF_URL=

# LINE Login（LIFF 所屬的 channel；驗證 ID token 的 audience）
LINE_LOGIN_CHANNEL_ID=
# Login 與 Messaging API channel 必須在同一個 Provider，userId 才會一致
LINE_PROVIDER_ID=
# 正式環境必須 true（HTTPS）；只有本機 http 測試才設 false
COOKIE_SECURE=true

# NOVARK（Service Token 只放後端，不可放前端或 LINE 訊息）
NOVARK_SERVICE_TOKEN=
NOVARK_INPUT_GUARD=true

# Worker：NOVARK 同時 4 個請求即回 429，並行數不要超過 2–3
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
REPLY_WINDOW_SECONDS=30

# 預設 sqlite+aiosqlite:////data/app.db（image 內建值），一般不需更改
# DATABASE_URL=
